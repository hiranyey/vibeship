{
  "admin": {
    "listen": "172.31.250.2:2019",
    "origins": ["caddy-api:2019"]
  },
  "apps": {
    "http": {
      "servers": {
        "vibeship": {
          "listen": [":80"],
          "automatic_https": { "disable": true },
          "logs": {},
          "routes": [
            {
              "@id": "vibeship-ui",
              "match": [{ "host": ["vibeship.localhost"] }],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "match": [{ "path": ["/hooks/*"] }],
                      "handle": [{ "handler": "vars", "log_skip": true }]
                    },
                    {
                      "handle": [{ "handler": "reverse_proxy", "upstreams": [{ "dial": "vibeship:3000" }] }]
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "not-found",
              "handle": [{ "handler": "static_response", "status_code": 404, "body": "No app is deployed at this address.\n" }]
            }
          ]
        }
      }
    }
  }
}
