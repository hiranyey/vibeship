# Copy to .env (npm run dev does this for you). Values here suit local dev;
# see SPEC.md "Local development and testing" for production values.

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://vibeship.localhost:8080
BASE_DOMAIN=localhost
TLS_MODE=off
CADDY_ADMIN_URL=http://caddy-api:2019

# Set by scripts/dev.sh locally; /opt/stack in production.
STACK_ROOT=

# 32 bytes in base64 that encrypt env values and registry tokens. Generate one
# with `npm run gen-key` (npm run dev fills it in for you). Keep a copy somewhere
# safe: if it is lost, stored secrets cannot be decrypted.
MASTER_KEY=

# Clerk OIDC. Optional until login lands in phase 3.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
