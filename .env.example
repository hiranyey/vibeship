# Copy to .env (npm run dev does this for you). Values here suit local dev;
# production values are written by scripts/bootstrap.sh (see PRODUCTION.md).

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://vibeship.localhost:8080
BASE_DOMAIN=localhost
TLS_MODE=off
CADDY_ADMIN_URL=http://caddy-api:2019

# Set by scripts/dev.sh locally; /opt/stack in production.
STACK_ROOT=

# 32 bytes in base64 that encrypt env values and registry tokens. Generate one
# with `npm run gen-key` (npm run dev fills it in for you). Keep a copy somewhere
# safe: if it is lost, stored secrets cannot be decrypted.
MASTER_KEY=

# Clerk OIDC for browser login: the issuer is the Clerk instance's frontend API
# URL, and the OAuth application's redirect URL must be <PUBLIC_URL>/auth/callback
# (http://vibeship.localhost:8080/auth/callback locally). Leave all three empty
# to turn browser login off; API tokens still work. Create the first token with
#   scripts/dev.sh exec vibeship npm run token -- <name> admin
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Comma-separated emails allowed to log in, checked on top of Clerk's own
# rules; only verified emails match. Empty: anyone Clerk lets in is admin.
# bootstrap.sh requires it in production.
ADMIN_EMAILS=
